{
  "schemaVersion": 1,
  "gate": "3F",
  "description": "萌芽人生逻辑测试模块注册表：源码影响映射 + JVM/真机入口 + 风险与隔离要求。由 scripts/verify.sh 读取。",
  "repo": {
    "appSourceRoot": "app/src/main/java/com/mengyalife/app",
    "jvmTestRoot": "app/src/test/java",
    "deviceScriptRoot": "tools/ui-verify",
    "apkQa": "app/build/outputs/apk/qa/app-qa.apk",
    "apkProd": "app/build/outputs/apk/debug/app-debug.apk",
    "gradleTestTask": ":app:testDebugUnitTest",
    "gradleQaAssemble": ":app:assembleQa",
    "gradleProdAssemble": ":app:assembleDebug"
  },
  "packages": {
    "qa": {
      "applicationId": "com.mengyalife.app.qa",
      "database": "mengya-life-qa.db",
      "versionSuffix": "-qa",
      "debuggable": true,
      "destructiveAllowed": true
    },
    "prod": {
      "applicationId": "com.mengyalife.app",
      "database": "mengya-life.db",
      "destructiveAllowed": false
    }
  },
  "levels": {
    "fast": {
      "id": "L0",
      "title": "Fast",
      "deviceTiers": [],
      "allModules": false,
      "description": "编译 + 受影响 JVM；不启动设备、不安装 APK。"
    },
    "feature": {
      "id": "L1",
      "title": "Feature",
      "deviceTiers": [
        "feature"
      ],
      "allModules": false,
      "description": "受影响 JVM + 对应模块 QA 真机功能测试 + 导航冒烟（若被映射）。"
    },
    "integration": {
      "id": "L2",
      "title": "Integration",
      "deviceTiers": [
        "feature",
        "integration"
      ],
      "allModules": false,
      "alwaysModules": [
        "database-migration",
        "ai-consent"
      ],
      "description": "跨模块依赖 + 数据库/迁移 + AI 隐私/授权 + 后台 Worker 高风险路径。"
    },
    "gate": {
      "id": "L3",
      "title": "Gate",
      "deviceTiers": [
        "feature",
        "integration",
        "gate"
      ],
      "allModules": true,
      "fullJvm": true,
      "requiresProdSmoke": true,
      "description": "全量 JVM + 全量 QA 真机 + 正式包只读冒烟 + 迁移/持久化 + 隐私用例。"
    },
    "release": {
      "id": "L4",
      "title": "Release",
      "deviceTiers": [
        "feature",
        "integration",
        "gate"
      ],
      "allModules": true,
      "fullJvm": true,
      "requiresProdSmoke": true,
      "requiresDevice": true,
      "forbidOptionalSkips": true,
      "description": "Gate 全部内容 + 严格要求设备/APK 哈希校验，不允许环境性跳过。"
    }
  },
  "levelOrder": [
    "fast",
    "feature",
    "integration",
    "gate",
    "release"
  ],
  "propagation": {
    "enabled": true,
    "maxDepth": 1,
    "description": "上游模块变化时，沿 dependsOn 反向扩展一层；规则可显式扩大。"
  },
  "unknownChangePolicy": {
    "level": "gate",
    "modules": "all",
    "exitCode": 0,
    "reason": "无法判定影响范围的源码变化必须保守升级到 L3 全量，并在报告中列出未知路径。"
  },
  "safety": {
    "requireQaPackageForDestructive": true,
    "requireQaBuildMarker": true,
    "prodReadOnly": true,
    "forbidUninstallProd": true,
    "forbidPmClearProd": true,
    "secretPatterns": [
      "sk-",
      "api_key",
      "Authorization: Bearer"
    ],
    "notes": "破坏性脚本仅允许 com.mengyalife.app.qa；正式包脚本必须 require_prod 且不清数据。"
  },
