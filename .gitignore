# Gradle
.gradle/
build/
app/build/
.kotlin/

# 设备/SDK 本地路径（AGP 通过 ANDROID_HOME 解析，本项目通常不需要该文件）
local.properties

# IDE
.idea/
*.iml
captures/

# 日志（保留 docs/reports/logs/ 下的构建与验证证据）
*.log
!docs/reports/logs/*.log

# 产物
*.apk
*.aab
!docs/reports/logs/*.apk.sha256

# Python 测试脚本缓存
__pycache__/
*.pyc

# 证据包未压缩目录（只提交 zip）
docs/reports/evidence/G2C-evidence/

# Gate 3A 证据未压缩目录（只提交 zip）
docs/reports/evidence/G3A-evidence/

# Gate 3B-1 证据未压缩目录（只提交 zip）
docs/reports/evidence/G3B1-evidence/

# Gate 3B-2 证据未压缩目录（只提交 zip）
docs/reports/evidence/G3B2-evidence/

# Gate 3C-1 证据未压缩目录（只提交 zip）
docs/reports/evidence/G3C1-evidence/

# Gate 3C-2 证据未压缩目录（只提交 zip）
docs/reports/evidence/G3C2-evidence/

# Gate 3D-1 证据未压缩目录（只提交 zip）
docs/reports/evidence/G3D1-evidence/

# Gate 3D-2 证据未压缩目录（只提交 zip）
docs/reports/evidence/G3D2-evidence/

# Gate 3E-1 证据未压缩目录（只提交 zip）
docs/reports/evidence/G3E1-evidence/

# Gate 3F 测试调度器本地状态（安装哈希/上次基线，不进仓库）
.verify/
__pycache__/

# 临时测试运行报告（验收报告另存 docs/reports/G3F-acceptance/）
docs/reports/test-runs/

# Gate 3F 验收日志（tracked；其他 *.log 仍忽略）
!docs/reports/G3F-acceptance/**/*.log
!docs/reports/G3F-acceptance/*.log
